[gd_resource type="AnimationNodeStateMachine" format=3 uid="uid://cfqjqu7r7m7kd"]

[sub_resource type="AnimationNodeAnimation" id="anim_fall"]
animation = &"fall"

[sub_resource type="AnimationNodeAnimation" id="anim_stand"]
animation = &"stand"

[sub_resource type="AnimationNodeAnimation" id="anim_jump"]
animation = &"jump"

[sub_resource type="AnimationNodeAnimation" id="anim_run"]
animation = &"run"

[sub_resource type="AnimationNodeAnimation" id="anim_walk"]
animation = &"walk"

[sub_resource type="AnimationNodeAnimation" id="anim_walkbackwards"]
animation = &"walkbackwards"

[sub_resource type="AnimationNodeAnimation" id="anim_shuffle_left"]
animation = &"shuffle_left"

[sub_resource type="AnimationNodeAnimation" id="anim_shuffle_right"]
animation = &"shuffle_right"

[sub_resource type="AnimationNodeAnimation" id="anim_jump_start"]
animation = &"jump_start"

[sub_resource type="AnimationNodeAnimation" id="anim_land"]
animation = &"jump_end"

[sub_resource type="AnimationNodeBlendSpace1D" id="locomotion"]
blend_point_0/node = SubResource("anim_stand")
blend_point_0/pos = 0.0
blend_point_1/node = SubResource("anim_walk")
blend_point_1/pos = 4.0
blend_point_2/node = SubResource("anim_run")
blend_point_2/pos = 5.5
blend_point_3/node = SubResource("anim_walkbackwards")
blend_point_3/pos = -4.0
min_space = -5.5
max_space = 5.5
value_label = "Speed"

[sub_resource type="AnimationNodeBlendSpace1D" id="turn"]
blend_point_0/node = SubResource("anim_shuffle_left")
blend_point_0/pos = -1.0
blend_point_1/node = SubResource("anim_stand")
blend_point_1/pos = 0.0
blend_point_2/node = SubResource("anim_shuffle_right")
blend_point_2/pos = 1.0
value_label = "Turn"

[sub_resource type="AnimationNodeStateMachineTransition" id="t_start"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="t_takeoff_end"]
switch_mode = 2
advance_mode = 2
xfade_time = 0.05

[sub_resource type="AnimationNodeStateMachineTransition" id="t_landing_end"]
switch_mode = 0
advance_mode = 2
advance_condition = &"land_finished"
xfade_time = 0.15

[sub_resource type="AnimationNodeStateMachineTransition" id="t_air"]
advance_mode = 1
xfade_time = 0.08

[sub_resource type="AnimationNodeStateMachineTransition" id="t_ground"]
advance_mode = 1
xfade_time = 0.15

[resource]
states/fall/node = SubResource("anim_fall")
states/fall/position = Vector2(640, 200)
states/locomotion/node = SubResource("locomotion")
states/locomotion/position = Vector2(200, 200)
states/turn/node = SubResource("turn")
states/turn/position = Vector2(200, 400)
states/jump_start/node = SubResource("anim_jump_start")
states/jump_start/position = Vector2(420, 0)
states/jump/node = SubResource("anim_jump")
states/jump/position = Vector2(640, 0)
states/land/node = SubResource("anim_land")
states/land/position = Vector2(420, 400)
